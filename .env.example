# Fluxer World Environment Configuration
# Copy this file to .env and adjust as needed

# ============================================
# Service Ports
# ============================================
FLUXER_PUBLIC_PORT=48763
FLUXER_ADMIN_PORT=8081
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
IPFS_SWARM_PORT=4001
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080
MEILI_PORT=7700
ELASTICSEARCH_PORT=9200
LIVEKIT_PORT=7880

# ============================================
# Search Configuration
# ============================================
# Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=dev-meilisearch-master-key

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=fluxer
POSTGRES_PASSWORD=fluxer
POSTGRES_DB=fluxer

# ============================================
# MinIO/S3 Configuration
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ============================================
# Optional: External Services
# ============================================
# Uncomment and configure if using external services
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password
