{
	"$schema": "../packages/config/src/ConfigSchema.json",
	"env": "development",
	"domain": {
		"base_domain": "${DOMAIN:-localhost}",
		"public_port": "${FLUXER_PUBLIC_PORT:-48763}"
	},
	"database": {
		"backend": "sqlite",
		"sqlite_path": "./data/dev.db"
	},
	"internal": {
		"kv": "${REDIS_URL:-redis://127.0.0.1:6379/0}",
		"kv_mode": "standalone"
	},
	"s3": {
		"access_key_id": "${S3_ACCESS_KEY_ID:-}",
		"secret_access_key": "${S3_SECRET_ACCESS_KEY:-}",
		"endpoint": "${S3_ENDPOINT:-http://127.0.0.1:49319/s3}"
	},
	"services": {
		"server": {
			"port": "${FLUXER_PUBLIC_PORT:-49319}",
			"host": "0.0.0.0"
		},
		"media_proxy": {
			"secret_key": ""
		},
		"admin": {
			"secret_key_base": "",
			"oauth_client_id": "${OAUTH_CLIENT_ID:-}",
			"oauth_client_secret": "${OAUTH_CLIENT_SECRET:-}"
		},
		"marketing": {
			"enabled": true,
			"port": 49531,
			"host": "0.0.0.0",
			"secret_key_base": ""
		},
		"gateway": {
			"port": 49107,
			"admin_reload_secret": "",
			"media_proxy_endpoint": "${FLUXER_MEDIA_URL:-http://localhost:49319/media}",
			"logger_level": "debug"
		},
		"nats": {
			"core_url": "${NATS_CORE_URL:-nats://127.0.0.1:4222}",
			"jetstream_url": "${NATS_JETSTREAM_URL:-nats://127.0.0.1:4223}"
		}
	},
	"auth": {
		"sudo_mode_secret": "",
		"connection_initiation_secret": "",
		"vapid": {
			"public_key": "",
			"private_key": ""
		},
		"bluesky": {
			"enabled": true,
			"keys": []
		}
	},
	"discovery": {
		"min_member_count": 1
	},
	"dev": {
		"disable_rate_limits": true
	},
	"integrations": {
		"email": {
			"enabled": true,
			"provider": "smtp",
			"from_email": "noreply@localhost",
			"smtp": {
				"host": "localhost",
				"port": 49621,
				"username": "dev",
				"password": "",
				"secure": false
			}
		},
		"gif": {
			"provider": "klipy"
		},
		"klipy": {
			"api_key": ""
		},
		"tenor": {
			"api_key": ""
		},
		"voice": {
			"enabled": true,
			"api_key": "${LIVEKIT_API_KEY:-}",
			"api_secret": "${LIVEKIT_API_SECRET:-}",
			"url": "ws://localhost:7880",
			"webhook_url": "${FLUXER_MEDIA_URL:-http://localhost:49319}/api/webhooks/livekit",
			"default_region": {
				"id": "default",
				"name": "Default",
				"emoji": "\ud83c\udf10",
				"latitude": 0.0,
				"longitude": 0.0
			}
		},
		"search": {
			"engine": "meilisearch",
			"url": "http://127.0.0.1:7700",
			"api_key": "${MEILI_MASTER_KEY:-}"
		}
	},
	"instance": {
		"private_key_path": ""
	},
	"federation": {
		"enabled": false
	}
}
