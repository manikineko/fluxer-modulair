{
	"$schema": "../packages/config/src/ConfigSchema.json",
	"env": "development",
	"domain": {
		"base_domain": "${DOMAIN:-localhost}",
		"public_port": "${FLUXER_PUBLIC_PORT:-49319}",
		"public_scheme": "http",
		"static_cdn_domain": "${FLUXER_STATIC_CDN:-localhost:8082}"
	},
	"endpoint_overrides": {
		"api": "${FLUXER_API_URL:-http://fluxer_server:49319/api}",
		"api_client": "${FLUXER_API_CLIENT_URL:-http://fluxer_server:49319/api}",
		"gateway": "${FLUXER_GATEWAY_URL:-http://fluxer_server:49107}",
		"media": "${FLUXER_MEDIA_URL:-http://fluxer_server:49319/media}",
		"static_cdn": "${FLUXER_STATIC_CDN:-http://localhost:8082}",
		"marketing": "${FLUXER_MARKETING_URL:-http://localhost:49531}",
		"admin": "${FLUXER_ADMIN_URL:-http://localhost:8081}",
		"invite": "${FLUXER_INVITE_URL:-http://localhost:48763/invite}",
		"gift": "${FLUXER_GIFT_URL:-http://localhost:48763/gift}"
	},
	"database": {
		"backend": "sqlite",
		"sqlite_path": "./data/dev.db"
	},
	"cookie": {
		"secure": false,
		"domain": ""
	},
	"internal": {
		"kv": "${REDIS_URL:-redis://valkey:6379/0}",
		"kv_mode": "standalone"
	},
	"s3": {
		"access_key_id": "${S3_ACCESS_KEY_ID:-minioadmin}",
		"secret_access_key": "${S3_SECRET_ACCESS_KEY:-minioadmin}",
		"endpoint": "${S3_ENDPOINT:-http://host.docker.internal:9000}",
		"buckets": {
			"cdn": "fluxer",
			"uploads": "fluxer-uploads",
			"downloads": "fluxer-downloads",
			"reports": "fluxer-reports",
			"harvests": "fluxer-harvests",
			"static": "fluxer-static"
		}
	},
	"services": {
		"server": {
			"port": "${FLUXER_PUBLIC_PORT:-49319}",
			"host": "0.0.0.0"
		},
		"media_proxy": {
			"secret_key": ""
		},
		"admin": {
			"secret_key_base": "dev-secret-key-base-change-in-production",
			"oauth_client_id": "${OAUTH_CLIENT_ID:-1234567890123456789}",
			"oauth_client_secret": "${OAUTH_CLIENT_SECRET:-dev-oauth-client-secret}",
			"base_path": ""
		},
		"marketing": {
			"enabled": true,
			"port": 49531,
			"host": "0.0.0.0",
			"secret_key_base": ""
		},
		"gateway": {
			"port": 49107,
			"admin_reload_secret": "",
			"media_proxy_endpoint": "${FLUXER_MEDIA_URL:-http://host.docker.internal:49319/media}",
			"logger_level": "debug"
		},
		"nats": {
			"core_url": "${NATS_CORE_URL:-nats://nats:4222}",
			"jetstream_url": "${NATS_JETSTREAM_URL:-nats://nats:4222}"
		}
	},
	"auth": {
		"sudo_mode_secret": "",
		"connection_initiation_secret": "",
		"vapid": {
			"public_key": "",
			"private_key": ""
		},
		"bluesky": {
			"enabled": false,
			"keys": []
		}
	},
	"discovery": {
		"min_member_count": 1
	},
	"dev": {
		"disable_rate_limits": true
	},
	"integrations": {
		"stripe": {
			"enabled": true,
			"secret_key": "${STRIPE_SECRET_KEY:-}",
			"webhook_secret": "${STRIPE_WEBHOOK_SECRET:-}",
			"prices": {
				"monthly_usd": "",
				"monthly_eur": "",
				"yearly_usd": "",
				"yearly_eur": "",
				"gift_1_month_usd": "",
				"gift_1_month_eur": "",
				"gift_1_year_usd": "",
				"gift_1_year_eur": ""
			}
		},
		"gif": {
			"provider": "klipy"
		},
		"klipy": {
			"api_key": ""
		},
		"tenor": {
			"api_key": ""
		},
		"voice": {
			"enabled": true,
			"api_key": "${LIVEKIT_API_KEY:-}",
			"api_secret": "${LIVEKIT_API_SECRET:-}",
			"url": "ws://host.docker.internal:7880",
			"webhook_url": "${FLUXER_MEDIA_URL:-http://host.docker.internal:49319}/api/webhooks/livekit",
			"default_region": {
				"id": "default",
				"name": "Default",
				"emoji": "\ud83c\udf10",
				"latitude": 0.0,
				"longitude": 0.0
			}
		},
		"search": {
			"engine": "meilisearch",
			"url": "http://meilisearch:7700",
			"api_key": "${MEILI_MASTER_KEY:-dev-meilisearch-master-key}"
		}
	},
	"instance": {
		"private_key_path": ""
	},
	"federation": {
		"enabled": false
	}
}
